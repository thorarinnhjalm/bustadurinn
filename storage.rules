rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Organization logos
    match /organizations/{orgId}/logo/{fileName} {
      // Anyone can read logos
      allow read: if true;

      // Only org admins can upload/update logos
      allow write: if request.auth != null &&
                      (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // House images
    match /houses/{houseId}/images/{fileName} {
      // Anyone can read house images
      allow read: if true;

      // Only admins can upload house images
      allow write: if request.auth != null && isSuperAdmin();
    }

    // User profile pictures
    match /users/{userId}/profile/{fileName} {
      // Anyone can read profile pictures
      allow read: if true;

      // Users can upload their own profile picture
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Helper functions
    function isSuperAdmin() {
      return request.auth != null &&
             firestore.get(/databases/(default)/documents/user_roles/$(request.auth.uid)).data.is_super_admin == true;
    }

    function isOrgAdmin(orgId) {
      return request.auth != null &&
             firestore.get(/databases/(default)/documents/user_roles/$(request.auth.uid)).data.organization_roles[orgId].role == 'org_admin';
    }
  }
}
