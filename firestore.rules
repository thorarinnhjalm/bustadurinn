rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
             (exists(/databases/$(database)/documents/user_roles/$(getUserId())) &&
              (get(/databases/$(database)/documents/user_roles/$(getUserId())).data.system_role == 'super_admin' ||
               get(/databases/$(database)/documents/user_roles/$(getUserId())).data.is_super_admin == true)) ||
             // Email fallback only counts when the address is verified, so
             // nobody can claim it by registering the address unverified.
             (getUserEmail() == 'thorarinnhjalmarsson@gmail.com' &&
              request.auth.token.email_verified == true)
      );
    }

    // Checking house membership robustly
    function isHouseMember(houseId) {
      return isAuthenticated() && 
             getUserId() in get(/databases/$(database)/documents/houses/$(houseId)).data.owner_ids;
    }

    function isHouseManager(houseId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/houses/$(houseId)).data.manager_id == getUserId();
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/organizations/$(orgId)).data.admin_uid == getUserId();
    }

    function isOrgMember(orgId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(getUserId()));
    }

    // ============================================
    // System & Promotions
    // ============================================

    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ============================================
    // Users & Roles
    // ============================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isAuthenticated() && userId == getUserId();
      allow delete: if isSuperAdmin();
    }

    match /user_roles/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // Houses Collection
    // ============================================

    match /houses/{houseId} {
      allow read: if isAuthenticated() && (
        (getUserId() in resource.data.owner_ids) || isSuperAdmin()
      );

      allow create: if isAuthenticated() && 
                      request.resource.data.manager_id == getUserId() &&
                      getUserId() in request.resource.data.owner_ids;

      allow update: if isAuthenticated() && (
        (resource.data.manager_id == getUserId()) || 
        isSuperAdmin() ||
        // Members may record house-state facts without being manager: which
        // supplies ran out, and that they swapped the gas cylinder. Whoever
        // is actually at the house is the one who knows, and they are rarely
        // the manager. Anything else still requires manager or super admin.
        (getUserId() in resource.data.owner_ids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supplies_out', 'gas_cylinder', 'updated_at']))
      );
      allow delete: if isAuthenticated() && (
        (resource.data.manager_id == getUserId()) || isSuperAdmin()
      );

      // --- House Subcollections ---

      match /tasks/{taskId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /finance_entries/{entryId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /budget_plans/{planId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /shopping_list/{itemId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /inventory/{itemId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /internal_logs/{logId} {
        allow read: if isHouseMember(houseId) || isSuperAdmin();
        allow create: if isHouseMember(houseId) || isSuperAdmin();
        allow update, delete: if isSuperAdmin();
      }

      // Bookings live in this subcollection (CalendarPage, bookingService,
      // fairnessService, arbokService all read/write here). There was no rule
      // for it, so every query fell through to the default deny.
      match /bookings/{bookingId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }
    }

    // ============================================
    // Organizations Collection (B2B)
    // ============================================

    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();

      match /members/{memberId} {
        allow read: if isAuthenticated() && (isOrgMember(orgId) || isOrgAdmin(orgId) || isSuperAdmin());
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /access_requests/{requestId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /booking_requests/{requestId} {
        allow create, read: if isAuthenticated();
        allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /admin_actions/{actionId} {
        allow read, write: if isOrgAdmin(orgId) || isSuperAdmin();
      }
    }

    // ============================================
    // Utility & Guest Collections
    // ============================================

    // Temporary Guest View Tokens
    // Doc id is the bearer token; docs carry `houseId` (the owning house) and,
    // for booking-bound magic links, `valid_until` (Timestamp).
    match /guest_views/{token} {
      // Unauthenticated guests can fetch a specific guest view document via token URL.
      // Links with a `valid_until` in the past are no longer served.
      allow get: if resource == null ||
                    !('valid_until' in resource.data) ||
                    !(resource.data.valid_until is timestamp) ||
                    resource.data.valid_until > request.time;
      // Members may list their own house's links (query must filter by houseId).
      allow list: if isSuperAdmin() ||
                     (isAuthenticated() && isHouseMember(resource.data.houseId));
      allow create: if isAuthenticated() && (
                      isSuperAdmin() ||
                      isHouseMember(request.resource.data.houseId)
                    );
      // The house must be a house the caller belongs to, and cannot be changed.
      allow update: if isAuthenticated() && (
                      isSuperAdmin() ||
                      (isHouseMember(resource.data.houseId) &&
                       request.resource.data.houseId == resource.data.houseId)
                    );
      allow delete: if isAuthenticated() && (
                      resource == null ||
                      isSuperAdmin() ||
                      isHouseMember(resource.data.houseId)
                    );
    }

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.user_id == getUserId();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.user_id == getUserId();
    }

    // Invitations are created by api/invite-member.ts (Admin SDK) and looked up
    // by invitees through api/invite-info.ts / api/join-house.ts, so clients
    // never create them and only house members (who can see the pending list
    // in Settings and revoke) may read or delete them. List queries must
    // filter by house_id.
    match /invitations/{invId} {
      allow read: if isAuthenticated() &&
                     (isHouseMember(resource.data.house_id) || isSuperAdmin());
      allow create, update: if false;
      allow delete: if isAuthenticated() &&
                       (isHouseMember(resource.data.house_id) || isSuperAdmin());
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /funnel_events/{eventId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /guestbook/{entryId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.user_id == getUserId() || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /internal_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /contact_submissions/{id} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /service_providers/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Legacy top-level bookings: real bookings live in houses/{id}/bookings.
    match /bookings/{id} {
      allow read, write: if isSuperAdmin();
    }

    // Top-level or collectionGroup tasks query for SuperAdmin
    match /{path=**}/tasks/{taskId} {
      allow read, write: if isSuperAdmin();
    }

  }
}
