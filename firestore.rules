rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
             (exists(/databases/$(database)/documents/user_roles/$(getUserId())) &&
              (get(/databases/$(database)/documents/user_roles/$(getUserId())).data.system_role == 'super_admin' ||
               get(/databases/$(database)/documents/user_roles/$(getUserId())).data.is_super_admin == true)) ||
             getUserEmail() == 'thorarinnhjalmarsson@gmail.com'
      );
    }

    // Checking house membership robustly
    function isHouseMember(houseId) {
      return isAuthenticated() && 
             getUserId() in get(/databases/$(database)/documents/houses/$(houseId)).data.owner_ids;
    }

    function isHouseManager(houseId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/houses/$(houseId)).data.manager_id == getUserId();
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/organizations/$(orgId)).data.admin_uid == getUserId();
    }

    function isOrgMember(orgId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(getUserId()));
    }

    // ============================================
    // System & Promotions
    // ============================================

    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ============================================
    // Users & Roles
    // ============================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isAuthenticated() && userId == getUserId();
      allow delete: if isSuperAdmin();
    }

    match /user_roles/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // Houses Collection
    // ============================================

    match /houses/{houseId} {
      allow read: if isAuthenticated() && (
        (getUserId() in resource.data.owner_ids) || isSuperAdmin()
      );

      allow create: if isAuthenticated() && 
                      request.resource.data.manager_id == getUserId() &&
                      getUserId() in request.resource.data.owner_ids;

      allow update: if isAuthenticated() && (
        (resource.data.manager_id == getUserId()) || 
        isSuperAdmin() ||
        (getUserId() in resource.data.owner_ids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supplies_out']))
      );
      allow delete: if isAuthenticated() && (
        (resource.data.manager_id == getUserId()) || isSuperAdmin()
      );

      // --- House Subcollections ---

      match /tasks/{taskId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /finance_entries/{entryId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /budget_plans/{planId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /shopping_list/{itemId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /inventory/{itemId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /internal_logs/{logId} {
        allow read: if isHouseMember(houseId) || isSuperAdmin();
        allow create: if isHouseMember(houseId) || isSuperAdmin();
        allow update, delete: if isSuperAdmin();
      }
    }

    // ============================================
    // Organizations Collection (B2B)
    // ============================================

    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();

      match /members/{memberId} {
        allow read: if isAuthenticated() && (isOrgMember(orgId) || isOrgAdmin(orgId) || isSuperAdmin());
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /access_requests/{requestId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /booking_requests/{requestId} {
        allow create, read: if isAuthenticated();
        allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /admin_actions/{actionId} {
        allow read, write: if isOrgAdmin(orgId) || isSuperAdmin();
      }
    }

    // ============================================
    // Utility & Guest Collections
    // ============================================

    // Temporary Guest View Tokens
    match /guest_views/{token} {
      // Unauthenticated guests can fetch a specific guest view document via token URL
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isAuthenticated();
    }

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.user_id == getUserId();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.user_id == getUserId();
    }

    match /invitations/{invId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
                             (resource.data.sender_uid == getUserId() || isSuperAdmin());
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /funnel_events/{eventId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /guestbook/{entryId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.user_id == getUserId() || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /internal_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /contact_submissions/{id} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /service_providers/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /bookings/{id} {
      allow read, write: if isAuthenticated();
    }

  }
}
