rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/user_roles/$(getUserId())) &&
             get(/databases/$(database)/documents/user_roles/$(getUserId())).data.is_super_admin == true;
    }

    // Checking house membership robustly
    function isHouseMember(houseId) {
      return isAuthenticated() && 
             getUserId() in get(/databases/$(database)/documents/houses/$(houseId)).data.owner_ids;
    }

    function isHouseManager(houseId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/houses/$(houseId)).data.manager_id == getUserId();
    }

    // ============================================
    // System & Promotions
    // ============================================

    match /system/{docId} {
      // Allow read for authenticated users (required for onboarding transactions)
      allow read: if isAuthenticated();
      // Only super admins can modify system settings
      allow write: if isSuperAdmin();
    }

    // ============================================
    // Users & Roles
    // ============================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isAuthenticated() && userId == getUserId();
      allow delete: if isSuperAdmin();
    }

    match /user_roles/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // Houses Collection
    // ============================================

    match /houses/{houseId} {
      // Members can read their houses
      // (Simplified read for now to prevent blocking, but ideally scoped)
      allow read: if isAuthenticated() && (isHouseMember(houseId) || isSuperAdmin());

      // FIX: Allow regular users to create a house where they are the manager
      allow create: if isAuthenticated() && 
                      request.resource.data.manager_id == getUserId() &&
                      getUserId() in request.resource.data.owner_ids;

      allow update: if isHouseManager(houseId) || isSuperAdmin();
      allow delete: if isHouseManager(houseId) || isSuperAdmin();

      // --- House Subcollections ---

      match /tasks/{taskId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /finance_entries/{entryId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /budget_plans/{planId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /shopping_list/{itemId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /internal_logs/{logId} {
        allow read: if isHouseMember(houseId) || isSuperAdmin();
        allow create: if isHouseMember(houseId) || isSuperAdmin();
        allow update, delete: if isSuperAdmin();
      }
    }

    // ============================================
    // Utility Collections
    // ============================================

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.user_id == getUserId();
      allow create: if isAuthenticated(); // Allow users to send join requests/notifs
      allow delete: if isAuthenticated() && resource.data.user_id == getUserId();
    }

    match /invitations/{invId} {
      allow read: if true; // Public check for join links
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
                             (resource.data.sender_uid == getUserId() || isSuperAdmin());
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

  }
}
