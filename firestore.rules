rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/user_roles/$(getUserId())) &&
             get(/databases/$(database)/documents/user_roles/$(getUserId())).data.is_super_admin == true;
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/user_roles/$(getUserId())) &&
             get(/databases/$(database)/documents/user_roles/$(getUserId())).data.organization_roles[orgId].role == 'org_admin';
    }

    function isOrgMember(orgId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/user_roles/$(getUserId())) &&
             orgId in get(/databases/$(database)/documents/user_roles/$(getUserId())).data.organization_roles;
    }

    function getOrgMemberStatus(orgId) {
      return get(/databases/$(database)/documents/user_roles/$(getUserId())).data.organization_roles[orgId].status;
    }

    function canAccessOrg(orgId) {
      return isSuperAdmin() || isOrgAdmin(orgId) ||
             (isOrgMember(orgId) && getOrgMemberStatus(orgId) in ['approved', 'active']);
    }

    // Check if the current user is a member of a personal house (uid in owner_ids)
    function isHouseMember(houseId) {
      return isAuthenticated() &&
             request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.owner_ids;
    }

    // Check if the current user is the manager of a house
    function isHouseManager(houseId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/houses/$(houseId)).data.manager_id == request.auth.uid;
    }

    // ============================================
    // Organizations Collection
    // ============================================

    match /organizations/{orgId} {
      // Super admins can do anything
      // Org admins can read and update their org
      // Members can read their org
      allow read: if canAccessOrg(orgId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isOrgAdmin(orgId);
      allow delete: if isSuperAdmin();

      // ============================================
      // Access Requests Subcollection
      // ============================================

      match /access_requests/{requestId} {
        // Anyone can create an access request (before auth)
        allow create: if true;

        // User can read their own request
        allow read: if isAuthenticated() &&
                       (resource.data.email == getUserEmail() ||
                        isOrgAdmin(orgId) ||
                        isSuperAdmin());

        // Only admins can update/delete
        allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // ============================================
      // Members Subcollection
      // ============================================

      match /members/{memberId} {
        // Admins can read all members
        // Members can read all members in their org (if active)
        allow read: if canAccessOrg(orgId);

        // Only admins can create/update/delete members
        allow create, update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // ============================================
      // Booking Requests Subcollection
      // ============================================

      match /booking_requests/{requestId} {
        // Members can create booking requests
        allow create: if canAccessOrg(orgId) &&
                         request.resource.data.user_id == getUserId();

        // User can read their own requests
        // Admins can read all requests
        allow read: if isAuthenticated() &&
                       (resource.data.user_id == getUserId() ||
                        isOrgAdmin(orgId) ||
                        isSuperAdmin());

        // User can update their own pending requests (to cancel)
        // Admins can update any request (to approve/deny)
        allow update: if isAuthenticated() &&
                         ((resource.data.user_id == getUserId() &&
                           resource.data.status == 'pending' &&
                           request.resource.data.status == 'cancelled') ||
                          isOrgAdmin(orgId) ||
                          isSuperAdmin());

        // Only admins can delete
        allow delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // ============================================
      // Admin Actions Subcollection
      // ============================================

      match /admin_actions/{actionId} {
        // Admins and members can read actions
        allow read: if canAccessOrg(orgId);

        // Only admins can create actions (logged automatically)
        allow create: if isOrgAdmin(orgId) || isSuperAdmin();

        // Nobody can update/delete actions (audit log)
        allow update, delete: if false;
      }
    }

    // ============================================
    // Users Collection
    // ============================================

    match /users/{userId} {
      // Users can read their own profile
      // Super admins can read any profile
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());

      // Users can create/update their own profile
      allow create, update: if isAuthenticated() && userId == getUserId();

      // Only super admins can delete users
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // User Roles Collection
    // ============================================

    match /user_roles/{userId} {
      // Users can read their own roles
      // Super admins can read any roles
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());

      // Only super admins and org admins can update roles
      allow create, update: if isSuperAdmin() ||
                               (isAuthenticated() &&
                                request.resource.data.keys().hasAny(['organization_roles']) &&
                                request.resource.data.organization_roles.keys().hasAny(
                                  get(/databases/$(database)/documents/user_roles/$(getUserId())).data.organization_roles.keys()
                                ));

      // Only super admins can delete roles
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // Houses Collection
    // ============================================

    match /houses/{houseId} {
      // Anyone can read houses (for browsing)
      allow read: if true;

      // Authenticated users can create their own personal house (manager_id must be their uid)
      // Org admins can create houses for their org
      // Super admins can do anything
      allow create: if isSuperAdmin() ||
                       (isAuthenticated() && request.resource.data.manager_id == request.auth.uid) ||
                       (isAuthenticated() &&
                        request.resource.data.organization_id != null &&
                        isOrgAdmin(request.resource.data.organization_id));

      // House manager or any member (owner_ids) can update the house
      // Org admins can update org houses
      // Super admins can do anything
      allow update: if isSuperAdmin() ||
                       (isAuthenticated() && resource.data.manager_id == request.auth.uid) ||
                       (isAuthenticated() && request.auth.uid in resource.data.owner_ids) ||
                       (isAuthenticated() &&
                        resource.data.organization_id != null &&
                        isOrgAdmin(resource.data.organization_id));

      // Only manager or super admin can delete a house
      allow delete: if isSuperAdmin() ||
                       (isAuthenticated() && resource.data.manager_id == request.auth.uid);

      // ============================================
      // Bookings Subcollection
      // ============================================

      match /bookings/{bookingId} {
        // Anyone can read bookings (to see availability)
        allow read: if true;

        // House members can create their own bookings
        // Org admins can create bookings for org houses
        allow create: if isSuperAdmin() ||
                         (isAuthenticated() &&
                          request.resource.data.user_id == request.auth.uid &&
                          isHouseMember(houseId)) ||
                         (isAuthenticated() &&
                          request.resource.data.organization_id != null &&
                          isOrgAdmin(request.resource.data.organization_id));

        // User can cancel their own confirmed booking
        // Any house member can update any booking
        // Org admins can update org house bookings
        allow update: if isAuthenticated() &&
                         ((resource.data.user_id == getUserId() &&
                           resource.data.status == 'confirmed' &&
                           request.resource.data.status == 'cancelled') ||
                          isSuperAdmin() ||
                          isHouseMember(houseId) ||
                          (resource.data.organization_id != null &&
                           isOrgAdmin(resource.data.organization_id)));

        // House members and admins can delete bookings
        allow delete: if isSuperAdmin() ||
                         isHouseMember(houseId) ||
                         (resource.data.organization_id != null &&
                          isOrgAdmin(resource.data.organization_id));
      }

      // ============================================
      // Tasks Subcollection
      // ============================================

      match /tasks/{taskId} {
        allow read: if isSuperAdmin() || isHouseMember(houseId);
        allow create: if isSuperAdmin() ||
                         (isAuthenticated() &&
                          request.resource.data.house_id == houseId &&
                          isHouseMember(houseId));
        allow update: if isSuperAdmin() || isHouseMember(houseId);
        allow delete: if isSuperAdmin() || isHouseManager(houseId);
      }

      // ============================================
      // Finance Entries Subcollection
      // ============================================

      match /finance_entries/{entryId} {
        allow read: if isSuperAdmin() || isHouseMember(houseId);
        allow create: if isSuperAdmin() ||
                         (isAuthenticated() &&
                          request.resource.data.house_id == houseId &&
                          isHouseMember(houseId));
        allow update: if isSuperAdmin() || isHouseMember(houseId);
        allow delete: if isSuperAdmin() || isHouseMember(houseId);
      }

      // ============================================
      // Budget Plans Subcollection
      // ============================================

      match /budget_plans/{planId} {
        allow read: if isSuperAdmin() || isHouseMember(houseId);
        allow create: if isSuperAdmin() ||
                         (isAuthenticated() && isHouseMember(houseId));
        allow update: if isSuperAdmin() || isHouseMember(houseId);
        allow delete: if isSuperAdmin() || isHouseManager(houseId);
      }

      // ============================================
      // Shopping List Subcollection
      // ============================================

      match /shopping_list/{itemId} {
        allow read: if isSuperAdmin() || isHouseMember(houseId);
        allow create: if isSuperAdmin() ||
                         (isAuthenticated() && isHouseMember(houseId));
        allow update: if isSuperAdmin() || isHouseMember(houseId);
        allow delete: if isSuperAdmin() || isHouseMember(houseId);
      }

      // ============================================
      // Internal Logs Subcollection (append-only for members)
      // ============================================

      match /internal_logs/{logId} {
        allow read: if isSuperAdmin() || isHouseMember(houseId);
        allow create: if isSuperAdmin() ||
                         (isAuthenticated() && isHouseMember(houseId));
        // Logs are immutable once written
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ============================================
    // Funnel Events (analytics - user writes own)
    // ============================================

    match /funnel_events/{eventId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == getUserId();
      allow update, delete: if false;
    }

    // ============================================
    // Notifications Collection
    // ============================================

    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
                     (resource.data.user_id == getUserId() || isSuperAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                       (resource.data.user_id == getUserId() || isSuperAdmin());
      allow delete: if isAuthenticated() &&
                       (resource.data.user_id == getUserId() || isSuperAdmin());
    }

    // ============================================
    // Contact Submissions
    // ============================================

    match /contact_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // ============================================
    // Email Templates
    // ============================================

    match /email_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // ============================================
    // Coupons
    // ============================================

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // ============================================
    // Feedback
    // ============================================

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == getUserId();
      allow read: if isAuthenticated() &&
                     (resource.data.uid == getUserId() || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    // ============================================
    // Invitations
    // ============================================

    match /invitations/{inviteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }
  }
}
