rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
             (exists(/databases/$(database)/documents/user_roles/$(getUserId())) &&
              (get(/databases/$(database)/documents/user_roles/$(getUserId())).data.system_role == 'super_admin' ||
               get(/databases/$(database)/documents/user_roles/$(getUserId())).data.is_super_admin == true)) ||
             // Email fallback only counts when the address is verified, so
             // nobody can claim it by registering the address unverified.
             (getUserEmail() == 'thorarinnhjalmarsson@gmail.com' &&
              request.auth.token.email_verified == true)
      );
    }

    // Checking house membership robustly
    function isHouseMember(houseId) {
      return isAuthenticated() && 
             getUserId() in get(/databases/$(database)/documents/houses/$(houseId)).data.owner_ids;
    }

    function isHouseManager(houseId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/houses/$(houseId)).data.manager_id == getUserId();
    }

    // Org admins are listed in organizations/{orgId}.admin_user_ids.
    function isOrgAdmin(orgId) {
      return isAuthenticated() &&
             'admin_user_ids' in get(/databases/$(database)/documents/organizations/$(orgId)).data &&
             getUserId() in get(/databases/$(database)/documents/organizations/$(orgId)).data.admin_user_ids;
    }

    // Same check against the state after the current write/batch commits; used
    // when the org doc is created in the same batch as the creator's member doc.
    function isOrgAdminAfter(orgId) {
      return isAuthenticated() &&
             'admin_user_ids' in getAfter(/databases/$(database)/documents/organizations/$(orgId)).data &&
             getUserId() in getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.admin_user_ids;
    }

    // Org members have a member doc whose ID is their uid.
    function isOrgMember(orgId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(getUserId()));
    }

    function isActiveOrgMember(orgId) {
      return isOrgMember(orgId) &&
             get(/databases/$(database)/documents/organizations/$(orgId)/members/$(getUserId())).data.status == 'active';
    }

    // The organization a house belongs to, or null. Callers must check
    // `houseOrgId(houseId) is string` before passing the result to an org helper.
    function houseOrgId(houseId) {
      return get(/databases/$(database)/documents/houses/$(houseId)).data.get('organization_id', null);
    }

    // A house may carry an organization_id only if the writer administers that
    // organization. Otherwise anyone could list their house under someone
    // else's organization and hand its admins write access to the bookings.
    function mayAttachHouseToOrg(orgId) {
      return orgId == null || (orgId is string && (isOrgAdmin(orgId) || isSuperAdmin()));
    }

    // ============================================
    // System & Promotions
    // ============================================

    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ============================================
    // Users & Roles
    // ============================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isAuthenticated() && userId == getUserId();
      allow delete: if isSuperAdmin();
    }

    match /user_roles/{userId} {
      allow read: if isAuthenticated() && (userId == getUserId() || isSuperAdmin());
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // Houses Collection
    // ============================================

    match /houses/{houseId} {
      allow read: if isAuthenticated() && (
        (getUserId() in resource.data.owner_ids) || isSuperAdmin() ||
        ('organization_id' in resource.data && resource.data.organization_id is string && (isActiveOrgMember(resource.data.organization_id) || isOrgAdmin(resource.data.organization_id)))
      );

      allow create: if isAuthenticated() && 
                      request.resource.data.manager_id == getUserId() &&
                      getUserId() in request.resource.data.owner_ids &&
                      mayAttachHouseToOrg(request.resource.data.get('organization_id', null));

      allow update: if isAuthenticated() && (
        // The manager may change anything, but may only attach the house to
        // an organization they administer (detaching is always allowed).
        (resource.data.manager_id == getUserId() &&
         (request.resource.data.get('organization_id', null) == resource.data.get('organization_id', null) ||
          mayAttachHouseToOrg(request.resource.data.get('organization_id', null)))) ||
        isSuperAdmin() ||
        // Members may record house-state facts without being manager: which
        // supplies ran out, and that they swapped the gas cylinder. Whoever
        // is actually at the house is the one who knows, and they are rarely
        // the manager. Anything else still requires manager or super admin.
        (getUserId() in resource.data.owner_ids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supplies_out', 'gas_cylinder', 'updated_at']))
      );
      allow delete: if isAuthenticated() && (
        (resource.data.manager_id == getUserId()) || isSuperAdmin()
      );

      // --- House Subcollections ---

      match /tasks/{taskId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /finance_entries/{entryId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /budget_plans/{planId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /shopping_list/{itemId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /inventory/{itemId} {
        allow read, write: if isHouseMember(houseId) || isSuperAdmin();
      }

      match /internal_logs/{logId} {
        allow read: if isHouseMember(houseId) || isSuperAdmin();
        allow create: if isHouseMember(houseId) || isSuperAdmin();
        allow update, delete: if isSuperAdmin();
      }

      // Bookings live in this subcollection (CalendarPage, bookingService,
      // fairnessService, arbokService all read/write here). House members and
      // super admins have full access. For houses that belong to an
      // organization, active org members may read (availability) and org
      // admins may also create/update/delete (approving booking requests).
      match /bookings/{bookingId} {
        allow read: if isHouseMember(houseId) || isSuperAdmin() ||
                       (houseOrgId(houseId) is string &&
                        (isActiveOrgMember(houseOrgId(houseId)) || isOrgAdmin(houseOrgId(houseId))));
        allow create, update, delete: if isHouseMember(houseId) || isSuperAdmin() ||
                       (houseOrgId(houseId) is string && isOrgAdmin(houseOrgId(houseId)));
      }
    }

    // ============================================
    // Organizations Collection (B2B)
    // ============================================

    match /organizations/{orgId} {
      // Single-document reads for any signed-in user (the request-access page
      // needs the org name); listing organizations is super admin only.
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create: if isAuthenticated() &&
                      request.resource.data.created_by == getUserId() &&
                      getUserId() in request.resource.data.admin_user_ids;
      allow update: if (isOrgAdmin(orgId) || isSuperAdmin()) &&
                      (!('admin_user_ids' in request.resource.data) || request.resource.data.admin_user_ids.size() > 0);
      allow delete: if isSuperAdmin();

      match /members/{memberId} {
        allow read: if isOrgAdmin(orgId) || isSuperAdmin() ||
                       (isAuthenticated() && memberId == getUserId());
        allow create: if isOrgAdmin(orgId) || isSuperAdmin() ||
                         (isAuthenticated() && memberId == getUserId() && isOrgAdminAfter(orgId));
        allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /access_requests/{requestId} {
        allow create: if isAuthenticated() &&
                        request.resource.data.user_id == getUserId() &&
                        request.resource.data.status == 'pending';
        allow read: if isOrgAdmin(orgId) || isSuperAdmin() ||
                       (isAuthenticated() && resource.data.user_id == getUserId());
        allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /booking_requests/{requestId} {
        allow create: if isAuthenticated() &&
                        request.resource.data.user_id == getUserId() &&
                        request.resource.data.status == 'pending' &&
                        (isActiveOrgMember(orgId) || isOrgAdmin(orgId));
        allow read: if isOrgAdmin(orgId) || isSuperAdmin() ||
                       (isAuthenticated() && resource.data.user_id == getUserId());
        allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // Audit log: append-only.
      match /admin_actions/{actionId} {
        allow read, create: if isOrgAdmin(orgId) || isSuperAdmin();
        allow update, delete: if false;
      }
    }

    // ============================================
    // Utility & Guest Collections
    // ============================================

    // Temporary Guest View Tokens
    // Doc id is the bearer token; docs carry `houseId` (the owning house) and,
    // for booking-bound magic links, `valid_until` (Timestamp).
    match /guest_views/{token} {
      // Unauthenticated guests can fetch a specific guest view document via token URL.
      // Links with a `valid_until` in the past are no longer served.
      allow get: if resource == null ||
                    !('valid_until' in resource.data) ||
                    !(resource.data.valid_until is timestamp) ||
                    resource.data.valid_until > request.time;
      // Members may list their own house's links (query must filter by houseId).
      allow list: if isSuperAdmin() ||
                     (isAuthenticated() && isHouseMember(resource.data.houseId));
      allow create: if isAuthenticated() && (
                      isSuperAdmin() ||
                      isHouseMember(request.resource.data.houseId)
                    );
      // The house must be a house the caller belongs to, and cannot be changed.
      allow update: if isAuthenticated() && (
                      isSuperAdmin() ||
                      (isHouseMember(resource.data.houseId) &&
                       request.resource.data.houseId == resource.data.houseId)
                    );
      allow delete: if isAuthenticated() && (
                      resource == null ||
                      isSuperAdmin() ||
                      isHouseMember(resource.data.houseId)
                    );
    }

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.user_id == getUserId();
      // Notifications are written by the API with the Admin SDK
      // (booking-notification, house-notification, guestbook-entry, cron).
      // Clients never create them, so nobody can push text into another
      // user's notification list.
      allow create: if false;
      allow delete: if isAuthenticated() && resource.data.user_id == getUserId();
    }

    // Invitations are created by api/invite-member.ts (Admin SDK) and looked up
    // by invitees through api/invite-info.ts / api/join-house.ts, so clients
    // never create them and only house members (who can see the pending list
    // in Settings and revoke) may read or delete them. List queries must
    // filter by house_id.
    match /invitations/{invId} {
      allow read: if isAuthenticated() &&
                     (isHouseMember(resource.data.house_id) || isSuperAdmin());
      allow create, update: if false;
      allow delete: if isAuthenticated() &&
                       (isHouseMember(resource.data.house_id) || isSuperAdmin());
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    // Public, sanitised copies of featured feedback for the landing page.
    // `feedback` documents also hold userId, userEmail, userAgent, path and
    // canContact, so they stay super-admin only. Each copy here holds ONLY
    // userName (first name), rating, comment, createdAt and featuredAt and is
    // written by the super admin in the same batch that toggles `featured`.
    match /featured_feedback/{feedbackId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isSuperAdmin();
    }

    match /funnel_events/{eventId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /guestbook/{entryId} {
      // Guest-link entries are written server-side (api/guestbook-entry.ts, Admin SDK).
      allow read, delete: if isAuthenticated() && (isHouseMember(resource.data.house_id) || isSuperAdmin());
      allow create: if isAuthenticated() && (isHouseMember(request.resource.data.house_id) || isSuperAdmin());
      allow update: if isSuperAdmin();
    }

    match /internal_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }

    match /contact_submissions/{id} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Public marketplace (Torgið): only approved ('active') providers are readable
    // by everyone; the list query must filter on status == 'active'.
    // Anyone may submit an application, but only as a pending, unrated entry.
    // Approval, rating changes, edits and deletes are super-admin only.
    match /service_providers/{id} {
      allow read: if isSuperAdmin() || resource.data.status == 'active' ||
                     (isAuthenticated() && resource.data.owner_uid == getUserId());
      allow create: if isSuperAdmin() || (
        request.resource.data.keys().hasOnly([
          'name', 'category', 'service_areas', 'website', 'description',
          'status', 'rating_avg', 'rating_count', 'created_at', 'owner_uid'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.rating_avg == 0 &&
        request.resource.data.rating_count == 0 &&
        request.resource.data.created_at == request.time &&
        (request.resource.data.owner_uid == null ||
         (isAuthenticated() && request.resource.data.owner_uid == getUserId())) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
        request.resource.data.category is string && request.resource.data.category.size() <= 50 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 2000 &&
        request.resource.data.website is string && request.resource.data.website.size() <= 300 &&
        request.resource.data.service_areas is list && request.resource.data.service_areas.size() <= 20
      );
      allow update, delete: if isSuperAdmin();
    }

    // Provider contact details (email, phone, address) live apart from the
    // world-readable service_providers docs; only signed-in users see them
    // (matches the UI). The doc id equals the provider id. Applicants create the
    // contact doc in the same batch as their (new, pending) provider doc:
    // the provider must not exist yet but must exist after the batch, with the
    // same owner_uid, so nobody can attach contact data to an existing provider.
    match /service_provider_contacts/{providerId} {
      allow read: if isAuthenticated() || isSuperAdmin();
      allow create: if isSuperAdmin() || (
        request.resource.data.keys().hasOnly([
          'contact_email', 'contact_phone', 'address', 'owner_uid'
        ]) &&
        !exists(/databases/$(database)/documents/service_providers/$(providerId)) &&
        existsAfter(/databases/$(database)/documents/service_providers/$(providerId)) &&
        getAfter(/databases/$(database)/documents/service_providers/$(providerId)).data.owner_uid
          == request.resource.data.owner_uid &&
        (request.resource.data.owner_uid == null ||
         (isAuthenticated() && request.resource.data.owner_uid == getUserId())) &&
        request.resource.data.contact_email is string && request.resource.data.contact_email.size() <= 200 &&
        request.resource.data.contact_phone is string && request.resource.data.contact_phone.size() <= 50 &&
        request.resource.data.address is string && request.resource.data.address.size() <= 300
      );
      allow update, delete: if isSuperAdmin();
    }

    // Provider reviews (Torgið). Public read (the marketplace computes each
    // provider's average from these). One review per user and provider: the
    // document id is `${providerId}_${uid}` and reviews cannot be edited.
    match /service_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'provider_id', 'user_id', 'user_name', 'rating', 'comment', 'created_at'
        ]) &&
        request.resource.data.user_id == getUserId() &&
        request.resource.data.provider_id is string &&
        reviewId == request.resource.data.provider_id + '_' + getUserId() &&
        exists(/databases/$(database)/documents/service_providers/$(request.resource.data.provider_id)) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment is string && request.resource.data.comment.size() <= 1000 &&
        request.resource.data.user_name is string && request.resource.data.user_name.size() <= 100 &&
        request.resource.data.created_at == request.time;
      allow update, delete: if isSuperAdmin();
    }

    // Email templates are edited from the super admin page and read server-side
    // (Admin SDK) by api/send-email.ts.
    match /email_templates/{id} {
      allow read, write: if isSuperAdmin();
    }

    // Legacy top-level bookings: real bookings live in houses/{id}/bookings.
    match /bookings/{id} {
      allow read, write: if isSuperAdmin();
    }

    // Top-level or collectionGroup tasks query for SuperAdmin
    match /{path=**}/tasks/{taskId} {
      allow read, write: if isSuperAdmin();
    }

    // Collection-group bookings query (admin stats). Read-only; rules are OR-ed
    // across matching blocks, so this grants nothing to anyone but super admins.
    match /{path=**}/bookings/{bookingId} {
      allow read: if isSuperAdmin();
    }

  }
}
